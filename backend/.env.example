# Groq — moteur IA de l'agent (gratuit, tool-calling)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# PayPal Sandbox — rail de paiement (Payouts API)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_RECEIVER_EMAIL=

# Serveur
PORT=4000

# Base SQLite (facultatif, chemin par défaut : backend/data/micropay.sqlite)
# MICROPAY_DB_PATH=
# Fichier JSON à importer au premier démarrage SQLite (facultatif)
# MICROPAY_LEGACY_DB_PATH=
